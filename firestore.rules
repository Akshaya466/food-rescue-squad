rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function listingPath(listingId) {
      return /databases/$(database)/documents/listings/$(listingId);
    }

    function deliveryPath(listingId) {
      return /databases/$(database)/documents/deliveries/$('listing_' + listingId);
    }

    function listingClaimPath(listingId) {
      return /databases/$(database)/documents/listingClaims/$(listingId);
    }

    function validLocation(value) {
      return value is map
        && value.keys().hasAll(['lat', 'lng', 'address'])
        && value.keys().hasOnly(['lat', 'lng', 'address'])
        && value.lat is number
        && value.lat >= -90
        && value.lat <= 90
        && value.lng is number
        && value.lng >= -180
        && value.lng <= 180
        && value.address is string
        && value.address.size() <= 500;
    }

    function validUserCreate(userId, data) {
      return data.keys().hasAll([
          'id', 'name', 'email', 'role', 'orgName', 'phone', 'location',
          'trustScore', 'totalRescues', 'isVerified', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'email', 'role', 'orgName', 'phone', 'location',
          'trustScore', 'totalRescues', 'isVerified', 'createdAt',
          'requestedRole'
        ])
        && data.id == userId
        && data.email is string
        && data.email.size() <= 255
        && (
          !('email' in request.auth.token)
          || data.email == request.auth.token.email
        )
        && (
          (data.role == 'collector' && !('requestedRole' in data))
          || (
            data.role == 'donor'
            && (
              !('requestedRole' in data)
              || data.requestedRole == 'volunteer'
            )
          )
        )
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 100
        && data.orgName is string
        && data.orgName.size() <= 200
        && data.phone is string
        && data.phone.size() <= 15
        && validLocation(data.location)
        && data.trustScore == 5
        && data.totalRescues == 0
        && data.isVerified == false
        && data.createdAt is string
        && data.createdAt.size() <= 40;
    }

    function validListing(data) {
      return data.keys().hasAll([
          'donorId', 'donorName', 'foodType', 'description', 'quantity',
          'unit', 'category', 'pickupWindowStart', 'pickupWindowEnd',
          'address', 'location', 'photos', 'status', 'claimedBy',
          'dietaryTags', 'urgencyLevel', 'createdAt'
        ])
        && data.keys().hasOnly([
          'donorId', 'donorName', 'foodType', 'description', 'quantity',
          'unit', 'category', 'pickupWindowStart', 'pickupWindowEnd',
          'address', 'location', 'photos', 'status', 'claimedBy',
          'dietaryTags', 'urgencyLevel', 'createdAt'
        ])
        && data.donorId == request.auth.uid
        && data.donorName is string
        && data.donorName.size() <= 200
        && data.foodType is string
        && data.foodType.size() > 0
        && data.foodType.size() <= 150
        && data.description is string
        && data.description.size() <= 5000
        && data.quantity is number
        && data.quantity > 0
        && data.quantity <= 1000000
        && data.unit in ['kg', 'portions', 'packets']
        && data.category in ['cooked', 'raw', 'packaged', 'beverages']
        && data.pickupWindowStart is string
        && data.pickupWindowStart.size() <= 40
        && data.pickupWindowEnd is string
        && data.pickupWindowEnd.size() <= 40
        && data.address is string
        && data.address.size() <= 500
        && validLocation(data.location)
        && data.location.address == data.address
        && data.photos is list
        && data.photos.size() == 0
        && data.status == 'active'
        && data.claimedBy == null
        && data.dietaryTags is list
        && data.dietaryTags.size() <= 20
        && data.dietaryTags.toSet().hasOnly([
          'Veg', 'Vegan', 'Halal', 'Jain', 'Contains Allergens'
        ])
        && data.dietaryTags.toSet().size() == data.dietaryTags.size()
        && data.urgencyLevel in ['low', 'medium', 'high']
        && data.createdAt is string
        && data.createdAt.size() <= 40;
    }

    match /users/{userId} {
      allow get: if signedIn()
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && validUserCreate(userId, request.resource.data);

      allow update: if signedIn()
        && request.auth.uid == userId
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'name', 'phone', 'orgName', 'location', 'requestedRole'
              ])
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2
            && request.resource.data.name.size() <= 100
            && request.resource.data.phone is string
            && request.resource.data.phone.size() <= 15
            && request.resource.data.orgName is string
            && request.resource.data.orgName.size() <= 200
            && validLocation(request.resource.data.location)
            && request.resource.data.location.lat == resource.data.location.lat
            && request.resource.data.location.lng == resource.data.location.lng
            && (
              !('requestedRole' in request.resource.data)
              || request.resource.data.requestedRole in ['donor', 'collector', 'volunteer']
            )
          )
          || (
            resource.data.role == 'donor'
            && resource.data.requestedRole == 'collector'
            && request.resource.data.role == 'collector'
            && !('requestedRole' in request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['role', 'requestedRole'])
          )
        );

      allow delete: if false;
    }

    match /listings/{listingId} {
      allow get, list: if isAdmin()
        || hasRole('collector')
        || (hasRole('donor') && resource.data.donorId == request.auth.uid);

      allow create: if hasRole('donor')
        && validListing(request.resource.data)
        && request.resource.data.donorName
          == (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgName != ''
              ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgName
              : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
          );

      allow update: if (
          (
            hasRole('donor')
            && resource.data.donorId == request.auth.uid
            && resource.data.status == 'active'
            && resource.data.claimedBy == null
            && request.resource.data.status == 'active'
            && request.resource.data.claimedBy == resource.data.claimedBy
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'foodType', 'description', 'quantity',
                'unit', 'category', 'urgencyLevel', 'address', 'location'
              ])
            && request.resource.data.foodType is string
            && request.resource.data.foodType.size() > 0
            && request.resource.data.foodType.size() <= 150
            && request.resource.data.description is string
            && request.resource.data.description.size() <= 5000
            && request.resource.data.quantity is number
            && request.resource.data.quantity > 0
            && request.resource.data.quantity <= 1000000
            && request.resource.data.unit in ['kg', 'portions', 'packets']
            && request.resource.data.category in ['cooked', 'raw', 'packaged', 'beverages']
            && request.resource.data.urgencyLevel in ['low', 'medium', 'high']
            && request.resource.data.address is string
            && request.resource.data.address.size() <= 500
            && validLocation(request.resource.data.location)
            && request.resource.data.location.lat == resource.data.location.lat
            && request.resource.data.location.lng == resource.data.location.lng
            && request.resource.data.location.address == request.resource.data.address
          )
          || (
            hasRole('collector')
            && resource.data.status == 'active'
            && resource.data.claimedBy == null
            && request.resource.data.status == 'claimed'
            && request.resource.data.claimedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'claimedBy'])
            && existsAfter(deliveryPath(listingId))
            && getAfter(deliveryPath(listingId)).data.listingId == listingId
            && getAfter(deliveryPath(listingId)).data.status == 'assigned'
            && getAfter(deliveryPath(listingId)).data.volunteerId == 'unassigned'
            && existsAfter(listingClaimPath(listingId))
            && getAfter(listingClaimPath(listingId)).data.collectorId == request.auth.uid
          )
          || (
            hasRole('collector')
            && resource.data.status == 'claimed'
            && resource.data.claimedBy == request.auth.uid
            && request.resource.data.status == 'active'
            && request.resource.data.claimedBy == null
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'claimedBy'])
            && get(deliveryPath(listingId)).data.status == 'assigned'
            && get(deliveryPath(listingId)).data.volunteerId == 'unassigned'
            && !existsAfter(deliveryPath(listingId))
            && get(listingClaimPath(listingId)).data.collectorId == request.auth.uid
            && !existsAfter(listingClaimPath(listingId))
          )
          || (
            hasRole('volunteer')
            && resource.data.status == 'claimed'
            && resource.data.claimedBy is string
            && request.resource.data.status == 'delivered'
            && request.resource.data.claimedBy == resource.data.claimedBy
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status'])
            && existsAfter(deliveryPath(listingId))
            && getAfter(deliveryPath(listingId)).data.listingId == listingId
            && getAfter(deliveryPath(listingId)).data.status == 'delivered'
            && getAfter(deliveryPath(listingId)).data.volunteerId == request.auth.uid
          )
        );

      allow delete: if resource.data.status == 'active'
        && (
          isAdmin()
          || (
            hasRole('donor')
            && resource.data.donorId == request.auth.uid
          )
        );
    }

    match /notifications/{notificationId} {
      allow get, list: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create, delete: if false;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.isRead == false
        && request.resource.data.isRead == true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead']);
    }

    match /listingClaims/{listingId} {
      allow get: if hasRole('volunteer')
        || (
          hasRole('collector')
          && (
            !exists(listingClaimPath(listingId))
            || resource.data.collectorId == request.auth.uid
          )
        );
      allow list: if hasRole('volunteer');

      allow create: if hasRole('collector')
        && request.resource.data.keys().hasAll([
          'listingId', 'collectorId', 'collectorName', 'donorId',
          'foodType', 'description', 'quantity', 'unit', 'pickupAddress', 'dropAddress',
          'pickupWindowStart', 'pickupWindowEnd', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'listingId', 'collectorId', 'collectorName', 'donorId',
          'foodType', 'description', 'quantity', 'unit', 'pickupAddress', 'dropAddress',
          'pickupWindowStart', 'pickupWindowEnd', 'createdAt'
        ])
        && request.resource.data.listingId == listingId
        && request.resource.data.collectorId == request.auth.uid
        && request.resource.data.collectorName
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && existsAfter(listingPath(listingId))
        && getAfter(listingPath(listingId)).data.status == 'claimed'
        && getAfter(listingPath(listingId)).data.claimedBy == request.auth.uid
        && request.resource.data.donorId == get(listingPath(listingId)).data.donorId
        && request.resource.data.foodType == get(listingPath(listingId)).data.foodType
        && request.resource.data.description == get(listingPath(listingId)).data.description
        && request.resource.data.quantity == get(listingPath(listingId)).data.quantity
        && request.resource.data.unit == get(listingPath(listingId)).data.unit
        && request.resource.data.pickupAddress == get(listingPath(listingId)).data.address
        && request.resource.data.pickupWindowStart
          == get(listingPath(listingId)).data.pickupWindowStart
        && request.resource.data.pickupWindowEnd
          == get(listingPath(listingId)).data.pickupWindowEnd
        && request.resource.data.dropAddress
          == (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.location.address != ''
              ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.location.address
              : 'NGO Location'
          )
        && existsAfter(deliveryPath(listingId))
        && getAfter(deliveryPath(listingId)).data.listingId == listingId
        && getAfter(deliveryPath(listingId)).data.status == 'assigned'
        && getAfter(deliveryPath(listingId)).data.volunteerId == 'unassigned'
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40;

      allow delete: if hasRole('collector')
        && resource.data.collectorId == request.auth.uid
        && get(listingPath(listingId)).data.status == 'claimed'
        && get(listingPath(listingId)).data.claimedBy == request.auth.uid
        && getAfter(listingPath(listingId)).data.status == 'active'
        && getAfter(listingPath(listingId)).data.claimedBy == null
        && !existsAfter(deliveryPath(listingId));

      allow update: if false;
    }

    match /ratings/{ratingId} {
      allow get, list: if signedIn()
        && resource.data.toUserId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /deliveries/{deliveryId} {
      allow get: if isAdmin()
        || (
          hasRole('volunteer')
          && (
            resource.data.status == 'assigned'
            || resource.data.volunteerId == request.auth.uid
          )
        )
        || (
          hasRole('collector')
          && (
            !exists(/databases/$(database)/documents/deliveries/$(deliveryId))
            || (
              resource.data.listingId is string
              && deliveryId == 'listing_' + resource.data.listingId
              && get(listingPath(resource.data.listingId)).data.claimedBy == request.auth.uid
            )
          )
        );
      allow list: if isAdmin()
        || (
          hasRole('volunteer')
          && (
            resource.data.status == 'assigned'
            || resource.data.volunteerId == request.auth.uid
          )
        );

      allow create: if hasRole('collector')
        && request.resource.data.keys().hasAll([
          'listingId', 'volunteerId', 'donorId', 'status', 'pickupAddress',
          'dropAddress', 'estimatedTime', 'distanceKm', 'foodDetails', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'listingId', 'volunteerId', 'donorId', 'status', 'pickupAddress',
          'dropAddress', 'estimatedTime', 'distanceKm', 'foodDetails', 'createdAt'
        ])
        && deliveryId == 'listing_' + request.resource.data.listingId
        && existsAfter(listingPath(request.resource.data.listingId))
        && getAfter(listingPath(request.resource.data.listingId)).data.status == 'claimed'
        && getAfter(listingPath(request.resource.data.listingId)).data.claimedBy == request.auth.uid
        && existsAfter(listingClaimPath(request.resource.data.listingId))
        && getAfter(listingClaimPath(request.resource.data.listingId)).data.collectorId == request.auth.uid
        && request.resource.data.volunteerId == 'unassigned'
        && request.resource.data.donorId == get(listingPath(request.resource.data.listingId)).data.donorId
        && request.resource.data.status == 'assigned'
        && request.resource.data.pickupAddress == get(listingPath(request.resource.data.listingId)).data.address
        && request.resource.data.dropAddress
          == (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.location.address != ''
              ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.location.address
              : 'NGO Location'
          )
        && request.resource.data.estimatedTime == '30 mins'
        && request.resource.data.distanceKm is number
        && request.resource.data.distanceKm >= 0
        && request.resource.data.distanceKm <= 20050
        && request.resource.data.foodDetails
          == get(listingPath(request.resource.data.listingId)).data.foodType
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40;

      allow update: if hasRole('volunteer')
        && resource.data.listingId is string
        && deliveryId == 'listing_' + resource.data.listingId
        && exists(listingPath(resource.data.listingId))
        && get(listingPath(resource.data.listingId)).data.status == 'claimed'
        && (
          (
            resource.data.status == 'assigned'
            && resource.data.volunteerId == 'unassigned'
            && request.resource.data.status == 'en_route'
            && request.resource.data.volunteerId == request.auth.uid
          )
          || (
            resource.data.volunteerId == request.auth.uid
            && (
              (resource.data.status == 'en_route' && request.resource.data.status == 'picked_up')
              || (resource.data.status == 'picked_up' && request.resource.data.status == 'delivered')
            )
            && request.resource.data.volunteerId == resource.data.volunteerId
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'volunteerId'])
        && (
          request.resource.data.status != 'delivered'
          || (
            getAfter(listingPath(resource.data.listingId)).data.status == 'delivered'
            && getAfter(listingPath(resource.data.listingId)).data.claimedBy
              == get(listingPath(resource.data.listingId)).data.claimedBy
          )
        );

      allow delete: if hasRole('collector')
        && resource.data.listingId is string
        && deliveryId == 'listing_' + resource.data.listingId
        && resource.data.status == 'assigned'
        && resource.data.volunteerId == 'unassigned'
        && get(listingPath(resource.data.listingId)).data.status == 'claimed'
        && get(listingPath(resource.data.listingId)).data.claimedBy == request.auth.uid
        && getAfter(listingPath(resource.data.listingId)).data.status == 'active'
        && getAfter(listingPath(resource.data.listingId)).data.claimedBy == null
        && !existsAfter(listingClaimPath(resource.data.listingId));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
